.VSCodeCounter/

# Cargo build output. Gigabytes, fully derived, and one `git add -A` from the history.
# Cargo.lock IS tracked: this workspace produces a binary, and a reproducible build needs
# pinned transitive versions.
/target/

# Personal permission allowlists. `.claude/settings.json` IS tracked -- it carries the
# brief §13 boundary hook, which is a project-wide rule, not a preference.
.claude/settings.local.json

# Benchmark corpora are never vendored: large, separately licensed, and pinned by digest in
# eval/src/marlowe_eval/datasets/fetch.py instead. LongMemEval-S alone is ~277 MB and is one
# `git add -A` away from entering the history permanently, where it cannot be removed without
# rewriting every commit after it.
data/
corpora/

# Python bytecode from the tools/ drivers.
__pycache__/
*.pyc

# ADR-004 embedding model. ~90 MB, never vendored, pinned by sha256 in tools/fetch_model.py.
models/

# Content-addressed embedding cache. Derived, deletable, and load-bearing only for wall-clock:
# ADR-004's model choice depends on the SECOND fit-and-score cycle being cheap.
.embedding-cache/

# Corpus-derived artifacts under runs/. These carry LongMemEval turns VERBATIM, and the corpus is
# separately licensed and never vendored -- a 1,000-turn slice is still a slice. All of them are
# deterministically regenerable from the pinned corpus by the committed tools, so nothing is lost:
#   spike-sample.json        <- tools/make_spike_sample.py
#   run.jsonl                <- the harness transport log (full ingested history)
#   scored-candidates.ndjson <- --dump-gate-features
runs/**/spike-sample.json
runs/**/run.jsonl
runs/**/scored-candidates.ndjson
.cold-cache-probe/
runs/session-d-coldprobe/

# ORT profiling dumps: ~170 MB each, over GitHub's 100 MB limit. Kept on disk, never committed.
runs/**/ort-profiles/

# Scratch profile roots written by measurement instruments (journals, embeddings,
# per-cell LOCALAPPDATA). Evidence lives in the .log/.json beside them.
runs/**/profile-*/
